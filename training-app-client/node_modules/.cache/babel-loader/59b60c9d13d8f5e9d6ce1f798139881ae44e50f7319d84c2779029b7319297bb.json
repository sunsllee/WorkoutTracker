{"ast":null,"code":"import { programApi, programExerciseApi } from '../services/apiService';\nexport default {\n  name: 'ProgramsList',\n  data() {\n    return {\n      programs: [],\n      loading: false,\n      isEditing: false,\n      formData: {\n        programId: null,\n        programTitle: '',\n        typeProgram: '',\n        active: true\n      },\n      // Для модального окна\n      showExercisesModal: false,\n      selectedProgram: null,\n      programExercises: [],\n      programExercisesLoading: false\n    };\n  },\n  mounted() {\n    this.fetchPrograms();\n  },\n  methods: {\n    async fetchPrograms() {\n      this.loading = true;\n      try {\n        const response = await programApi.getAll();\n        this.programs = response.data;\n      } catch (error) {\n        alert(error.displayMessage || 'Не удалось загрузить программы');\n      } finally {\n        this.loading = false;\n      }\n    },\n    async saveProgram() {\n      try {\n        if (!this.formData.programTitle.trim()) {\n          alert('Название программы обязательно');\n          return;\n        }\n        if (!this.formData.typeProgram) {\n          alert('Выберите тип программы');\n          return;\n        }\n        const payload = {\n          programTitle: this.formData.programTitle.trim(),\n          typeProgram: this.formData.typeProgram,\n          active: this.formData.active\n        };\n        if (this.isEditing && this.formData.programId) {\n          await programApi.update(this.formData.programId, payload);\n        } else {\n          await programApi.create(payload);\n        }\n        await this.fetchPrograms();\n        this.resetForm();\n      } catch (error) {\n        alert(error.displayMessage || 'Ошибка при сохранении программы');\n      }\n    },\n    editProgram(program) {\n      this.isEditing = true;\n      this.formData = {\n        programId: program.programId,\n        programTitle: program.programTitle,\n        typeProgram: program.typeProgram,\n        active: program.active\n      };\n      document.querySelector('.program-form').scrollIntoView({\n        behavior: 'smooth'\n      });\n    },\n    async confirmDelete(program) {\n      if (!confirm(`Удалить программу \"${program.programTitle}\"?`)) return;\n      try {\n        await programApi.delete(program.programId);\n        await this.fetchPrograms();\n        if (this.isEditing && this.formData.programId === program.programId) {\n          this.resetForm();\n        }\n      } catch (error) {\n        alert(error.displayMessage || 'Не удалось удалить программу');\n      }\n    },\n    async viewExercises(program) {\n      this.selectedProgram = program;\n      this.showExercisesModal = true;\n      this.programExercisesLoading = true;\n      try {\n        const response = await programExerciseApi.getByProgramId(program.programId);\n        this.programExercises = response.data;\n      } catch (error) {\n        alert(error.displayMessage || 'Не удалось загрузить упражнения программы');\n        this.programExercises = [];\n      } finally {\n        this.programExercisesLoading = false;\n      }\n    },\n    closeModal() {\n      this.showExercisesModal = false;\n      this.selectedProgram = null;\n      this.programExercises = [];\n    },\n    resetForm() {\n      this.isEditing = false;\n      this.formData = {\n        programId: null,\n        programTitle: '',\n        typeProgram: '',\n        active: true\n      };\n    }\n  }\n};","map":{"version":3,"names":["programApi","programExerciseApi","name","data","programs","loading","isEditing","formData","programId","programTitle","typeProgram","active","showExercisesModal","selectedProgram","programExercises","programExercisesLoading","mounted","fetchPrograms","methods","response","getAll","error","alert","displayMessage","saveProgram","trim","payload","update","create","resetForm","editProgram","program","document","querySelector","scrollIntoView","behavior","confirmDelete","confirm","delete","viewExercises","getByProgramId","closeModal"],"sources":["C:\\Users\\W\\Desktop\\практика\\training-app-client\\src\\components\\ProgramsList.vue"],"sourcesContent":["<template>\r\n  <div class=\"programs-container\">\r\n    <h2 class=\"section-title\">📋 Программы тренировок</h2>\r\n    \r\n    <div class=\"program-form card\">\r\n      <h3>{{ isEditing ? 'Редактировать программу' : 'Создать программу' }}</h3>\r\n      <form @submit.prevent=\"saveProgram\">\r\n        <div class=\"form-group\">\r\n          <label for=\"programTitle\">Название программы *</label>\r\n          <input\r\n            id=\"programTitle\"\r\n            v-model=\"formData.programTitle\"\r\n            type=\"text\"\r\n            class=\"form-control\"\r\n            placeholder=\"Введите название программы\"\r\n            required\r\n            maxlength=\"100\"\r\n          />\r\n        </div>\r\n        \r\n        <div class=\"form-group\">\r\n          <label for=\"typeProgram\">Тип программы *</label>\r\n          <select\r\n            id=\"typeProgram\"\r\n            v-model=\"formData.typeProgram\"\r\n            class=\"form-control\"\r\n            required\r\n          >\r\n            <option value=\"\">Выберите тип</option>\r\n            <option value=\"Силовая\">💪 Силовая</option>\r\n            <option value=\"Кардио\">🏃 Кардио</option>\r\n            <option value=\"Функциональная\">🎯 Функциональная</option>\r\n            <option value=\"Йога\">🧘 Йога</option>\r\n            <option value=\"Растяжка\">🤸 Растяжка</option>\r\n            <option value=\"Круговая\">🔄 Круговая</option>\r\n            <option value=\"Другое\">📌 Другое</option>\r\n          </select>\r\n        </div>\r\n        \r\n        <div class=\"form-group\">\r\n          <label>\r\n            <input v-model=\"formData.active\" type=\"checkbox\" />\r\n            Активная\r\n          </label>\r\n          <small class=\"text-muted\">Неактивные программы не будут отображаться в списках</small>\r\n        </div>\r\n        \r\n        <div class=\"form-actions\">\r\n          <button type=\"submit\" class=\"btn btn-primary\">\r\n            {{ isEditing ? 'Обновить' : 'Создать' }}\r\n          </button>\r\n          <button v-if=\"isEditing\" type=\"button\" class=\"btn btn-secondary\" @click=\"resetForm\">\r\n            Отмена\r\n          </button>\r\n        </div>\r\n      </form>\r\n    </div>\r\n    \r\n    <!-- Список программ -->\r\n    <div class=\"programs-list\">\r\n      <div class=\"list-header\">\r\n        <span>Название</span>\r\n        <span>Тип</span>\r\n        <span>Статус</span>\r\n        <span>Действия</span>\r\n      </div>\r\n      \r\n      <div v-if=\"loading\" class=\"loading-spinner\">Загрузка...</div>\r\n      <div v-else-if=\"programs.length === 0\" class=\"empty-state\">\r\n        Программ пока нет. Создайте первую!\r\n      </div>\r\n      \r\n      <div\r\n        v-for=\"program in programs\"\r\n        :key=\"program.programId\"\r\n        class=\"program-item\"\r\n        :class=\"{ 'inactive': !program.active }\"\r\n      >\r\n        <span class=\"program-title\">{{ program.programTitle }}</span>\r\n        \r\n        <span class=\"program-type\">\r\n          <span class=\"badge badge-info\">{{ program.typeProgram }}</span>\r\n        </span>\r\n        \r\n        <span class=\"program-status\">\r\n          <span :class=\"['badge', program.active ? 'badge-success' : 'badge-secondary']\">\r\n            {{ program.active ? '✅ Активна' : '❌ Неактивна' }}\r\n          </span>\r\n        </span>\r\n        \r\n        <span class=\"program-actions\">\r\n          <button class=\"btn btn-sm btn-info\" @click=\"viewExercises(program)\">\r\n            📋\r\n          </button>\r\n          <button class=\"btn btn-sm btn-warning\" @click=\"editProgram(program)\">\r\n            ✏️\r\n          </button>\r\n          <button class=\"btn btn-sm btn-danger\" @click=\"confirmDelete(program)\">\r\n            🗑️\r\n          </button>\r\n        </span>\r\n      </div>\r\n    </div>\r\n\r\n    <!-- Модальное окно для просмотра упражнений программы -->\r\n    <div v-if=\"showExercisesModal\" class=\"modal-overlay\" @click.self=\"closeModal\">\r\n      <div class=\"modal-content\">\r\n        <div class=\"modal-header\">\r\n          <h3>Упражнения программы: {{ selectedProgram?.programTitle }}</h3>\r\n          <button class=\"btn-close\" @click=\"closeModal\">&times;</button>\r\n        </div>\r\n        <div class=\"modal-body\">\r\n          <div v-if=\"programExercisesLoading\" class=\"loading-spinner\">Загрузка упражнений...</div>\r\n          <div v-else-if=\"programExercises.length === 0\" class=\"empty-state\">\r\n            В этой программе пока нет упражнений\r\n          </div>\r\n          <div v-else>\r\n            <div\r\n              v-for=\"pe in programExercises\"\r\n              :key=\"pe.exerciseId\"\r\n              class=\"exercise-in-program\"\r\n            >\r\n              <span class=\"exercise-name\">{{ pe.exercise?.exerciseTitle || 'Без названия' }}</span>\r\n              <span class=\"exercise-sets\">\r\n                Подходов: {{ pe.setsCount || '—' }}\r\n              </span>\r\n              <span class=\"exercise-reps\">\r\n                Повторений: {{ pe.repsCount || '—' }}\r\n              </span>\r\n            </div>\r\n          </div>\r\n        </div>\r\n        <div class=\"modal-footer\">\r\n          <button class=\"btn btn-secondary\" @click=\"closeModal\">Закрыть</button>\r\n        </div>\r\n      </div>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport { programApi, programExerciseApi } from '../services/apiService';\r\n\r\nexport default {\r\n  name: 'ProgramsList',\r\n  data() {\r\n    return {\r\n      programs: [],\r\n      loading: false,\r\n      isEditing: false,\r\n      formData: {\r\n        programId: null,\r\n        programTitle: '',\r\n        typeProgram: '',\r\n        active: true\r\n      },\r\n      // Для модального окна\r\n      showExercisesModal: false,\r\n      selectedProgram: null,\r\n      programExercises: [],\r\n      programExercisesLoading: false\r\n    };\r\n  },\r\n  mounted() {\r\n    this.fetchPrograms();\r\n  },\r\n  methods: {\r\n    async fetchPrograms() {\r\n      this.loading = true;\r\n      try {\r\n        const response = await programApi.getAll();\r\n        this.programs = response.data;\r\n      } catch (error) {\r\n        alert(error.displayMessage || 'Не удалось загрузить программы');\r\n      } finally {\r\n        this.loading = false;\r\n      }\r\n    },\r\n    \r\n    async saveProgram() {\r\n      try {\r\n        if (!this.formData.programTitle.trim()) {\r\n          alert('Название программы обязательно');\r\n          return;\r\n        }\r\n        \r\n        if (!this.formData.typeProgram) {\r\n          alert('Выберите тип программы');\r\n          return;\r\n        }\r\n        \r\n        const payload = {\r\n          programTitle: this.formData.programTitle.trim(),\r\n          typeProgram: this.formData.typeProgram,\r\n          active: this.formData.active\r\n        };\r\n        \r\n        if (this.isEditing && this.formData.programId) {\r\n          await programApi.update(this.formData.programId, payload);\r\n        } else {\r\n          await programApi.create(payload);\r\n        }\r\n        \r\n        await this.fetchPrograms();\r\n        this.resetForm();\r\n      } catch (error) {\r\n        alert(error.displayMessage || 'Ошибка при сохранении программы');\r\n      }\r\n    },\r\n    \r\n    editProgram(program) {\r\n      this.isEditing = true;\r\n      this.formData = {\r\n        programId: program.programId,\r\n        programTitle: program.programTitle,\r\n        typeProgram: program.typeProgram,\r\n        active: program.active\r\n      };\r\n      document.querySelector('.program-form').scrollIntoView({ behavior: 'smooth' });\r\n    },\r\n    \r\n    async confirmDelete(program) {\r\n      if (!confirm(`Удалить программу \"${program.programTitle}\"?`)) return;\r\n      \r\n      try {\r\n        await programApi.delete(program.programId);\r\n        await this.fetchPrograms();\r\n        if (this.isEditing && this.formData.programId === program.programId) {\r\n          this.resetForm();\r\n        }\r\n      } catch (error) {\r\n        alert(error.displayMessage || 'Не удалось удалить программу');\r\n      }\r\n    },\r\n    \r\n    async viewExercises(program) {\r\n      this.selectedProgram = program;\r\n      this.showExercisesModal = true;\r\n      this.programExercisesLoading = true;\r\n      \r\n      try {\r\n        const response = await programExerciseApi.getByProgramId(program.programId);\r\n        this.programExercises = response.data;\r\n      } catch (error) {\r\n        alert(error.displayMessage || 'Не удалось загрузить упражнения программы');\r\n        this.programExercises = [];\r\n      } finally {\r\n        this.programExercisesLoading = false;\r\n      }\r\n    },\r\n    \r\n    closeModal() {\r\n      this.showExercisesModal = false;\r\n      this.selectedProgram = null;\r\n      this.programExercises = [];\r\n    },\r\n    \r\n    resetForm() {\r\n      this.isEditing = false;\r\n      this.formData = {\r\n        programId: null,\r\n        programTitle: '',\r\n        typeProgram: '',\r\n        active: true\r\n      };\r\n    }\r\n  }\r\n};\r\n</script>\r\n\r\n<style scoped>\r\n.programs-container {\r\n  max-width: 900px;\r\n  margin: 0 auto;\r\n  padding: 20px;\r\n}\r\n\r\n.section-title {\r\n  margin-bottom: 24px;\r\n  color: #2c3e50;\r\n}\r\n\r\n.card {\r\n  background: white;\r\n  border-radius: 8px;\r\n  padding: 20px;\r\n  margin-bottom: 30px;\r\n  box-shadow: 0 2px 8px rgba(0,0,0,0.1);\r\n}\r\n\r\n.form-group {\r\n  margin-bottom: 16px;\r\n}\r\n\r\n.form-group label {\r\n  display: block;\r\n  margin-bottom: 4px;\r\n  font-weight: 500;\r\n}\r\n\r\n.form-control {\r\n  width: 100%;\r\n  padding: 8px 12px;\r\n  border: 1px solid #ddd;\r\n  border-radius: 4px;\r\n  font-size: 14px;\r\n}\r\n\r\n.form-control:focus {\r\n  border-color: #42b983;\r\n  outline: none;\r\n  box-shadow: 0 0 0 2px rgba(66, 185, 131, 0.2);\r\n}\r\n\r\n.form-actions {\r\n  display: flex;\r\n  gap: 8px;\r\n  margin-top: 12px;\r\n}\r\n\r\n.btn {\r\n  padding: 8px 20px;\r\n  border: none;\r\n  border-radius: 4px;\r\n  cursor: pointer;\r\n  font-size: 14px;\r\n  transition: background 0.2s;\r\n}\r\n\r\n.btn-primary {\r\n  background: #42b983;\r\n  color: white;\r\n}\r\n.btn-primary:hover {\r\n  background: #359268;\r\n}\r\n\r\n.btn-secondary {\r\n  background: #6c757d;\r\n  color: white;\r\n}\r\n.btn-secondary:hover {\r\n  background: #5a6268;\r\n}\r\n\r\n.btn-info {\r\n  background: #17a2b8;\r\n  color: white;\r\n}\r\n.btn-info:hover {\r\n  background: #138496;\r\n}\r\n\r\n.btn-warning {\r\n  background: #ffc107;\r\n  color: #212529;\r\n}\r\n.btn-warning:hover {\r\n  background: #e0a800;\r\n}\r\n\r\n.btn-danger {\r\n  background: #dc3545;\r\n  color: white;\r\n}\r\n.btn-danger:hover {\r\n  background: #bd2130;\r\n}\r\n\r\n.btn-sm {\r\n  padding: 4px 8px;\r\n  font-size: 12px;\r\n}\r\n\r\n.list-header {\r\n  display: grid;\r\n  grid-template-columns: 2fr 1.5fr 1.5fr 1fr;\r\n  padding: 10px 12px;\r\n  font-weight: 600;\r\n  border-bottom: 2px solid #e9ecef;\r\n  background: #f8f9fa;\r\n  border-radius: 4px 4px 0 0;\r\n}\r\n\r\n.program-item {\r\n  display: grid;\r\n  grid-template-columns: 2fr 1.5fr 1.5fr 1fr;\r\n  align-items: center;\r\n  padding: 10px 12px;\r\n  border-bottom: 1px solid #e9ecef;\r\n  background: white;\r\n}\r\n\r\n.program-item:hover {\r\n  background: #f8f9fa;\r\n}\r\n\r\n.program-item.inactive {\r\n  opacity: 0.6;\r\n}\r\n\r\n.program-title {\r\n  font-weight: 500;\r\n  word-break: break-word;\r\n  padding-right: 12px;\r\n}\r\n\r\n.badge {\r\n  padding: 4px 12px;\r\n  border-radius: 20px;\r\n  font-size: 12px;\r\n  font-weight: 500;\r\n}\r\n\r\n.badge-success {\r\n  background: #d4edda;\r\n  color: #155724;\r\n}\r\n\r\n.badge-secondary {\r\n  background: #e9ecef;\r\n  color: #6c757d;\r\n}\r\n\r\n.badge-info {\r\n  background: #d1ecf1;\r\n  color: #0c5460;\r\n}\r\n\r\n.program-actions {\r\n  display: flex;\r\n  gap: 6px;\r\n  justify-content: flex-end;\r\n}\r\n\r\n.loading-spinner {\r\n  padding: 40px;\r\n  text-align: center;\r\n  color: #6c757d;\r\n}\r\n\r\n.empty-state {\r\n  padding: 40px;\r\n  text-align: center;\r\n  color: #6c757d;\r\n  background: #f8f9fa;\r\n  border-radius: 4px;\r\n}\r\n\r\n.text-muted {\r\n  color: #6c757d;\r\n  font-size: 12px;\r\n  display: block;\r\n  margin-top: 4px;\r\n}\r\n\r\n/* Модальное окно */\r\n.modal-overlay {\r\n  position: fixed;\r\n  top: 0;\r\n  left: 0;\r\n  width: 100%;\r\n  height: 100%;\r\n  background: rgba(0, 0, 0, 0.5);\r\n  display: flex;\r\n  justify-content: center;\r\n  align-items: center;\r\n  z-index: 1000;\r\n}\r\n\r\n.modal-content {\r\n  background: white;\r\n  border-radius: 8px;\r\n  max-width: 600px;\r\n  width: 90%;\r\n  max-height: 80vh;\r\n  overflow: hidden;\r\n  box-shadow: 0 4px 20px rgba(0, 0, 0, 0.3);\r\n}\r\n\r\n.modal-header {\r\n  padding: 16px 20px;\r\n  border-bottom: 1px solid #e9ecef;\r\n  display: flex;\r\n  justify-content: space-between;\r\n  align-items: center;\r\n}\r\n\r\n.modal-header h3 {\r\n  margin: 0;\r\n  font-size: 18px;\r\n}\r\n\r\n.btn-close {\r\n  background: none;\r\n  border: none;\r\n  font-size: 24px;\r\n  cursor: pointer;\r\n  color: #6c757d;\r\n  padding: 0 8px;\r\n}\r\n.btn-close:hover {\r\n  color: #343a40;\r\n}\r\n\r\n.modal-body {\r\n  padding: 20px;\r\n  max-height: 50vh;\r\n  overflow-y: auto;\r\n}\r\n\r\n.modal-footer {\r\n  padding: 12px 20px;\r\n  border-top: 1px solid #e9ecef;\r\n  display: flex;\r\n  justify-content: flex-end;\r\n}\r\n\r\n.exercise-in-program {\r\n  display: flex;\r\n  justify-content: space-between;\r\n  padding: 8px 0;\r\n  border-bottom: 1px solid #f0f0f0;\r\n}\r\n\r\n.exercise-name {\r\n  font-weight: 500;\r\n 