{"ast":null,"code":"import { exerciseApi } from '../services/apiService';\nexport default {\n  name: 'ExercisesList',\n  data() {\n    return {\n      exercises: [],\n      loading: false,\n      isEditing: false,\n      formData: {\n        exerciseId: null,\n        exerciseTitle: '',\n        active: true\n      }\n    };\n  },\n  mounted() {\n    this.fetchExercises();\n  },\n  methods: {\n    async fetchExercises() {\n      this.loading = true;\n      try {\n        const response = await exerciseApi.getAll();\n        this.exercises = response.data;\n      } catch (error) {\n        alert(error.displayMessage || 'Не удалось загрузить упражнения');\n      } finally {\n        this.loading = false;\n      }\n    },\n    async saveExercise() {\n      try {\n        if (!this.formData.exerciseTitle.trim()) {\n          alert('Название упражнения обязательно');\n          return;\n        }\n        const payload = {\n          exerciseTitle: this.formData.exerciseTitle.trim(),\n          active: this.formData.active\n        };\n        if (this.isEditing && this.formData.exerciseId) {\n          await exerciseApi.update(this.formData.exerciseId, payload);\n        } else {\n          await exerciseApi.create(payload);\n        }\n        await this.fetchExercises();\n        this.resetForm();\n      } catch (error) {\n        alert(error.displayMessage || 'Ошибка при сохранении упражнения');\n      }\n    },\n    editExercise(exercise) {\n      this.isEditing = true;\n      this.formData = {\n        exerciseId: exercise.exerciseId,\n        exerciseTitle: exercise.exerciseTitle,\n        active: exercise.active\n      };\n      // Прокрутка к форме\n      document.querySelector('.exercise-form').scrollIntoView({\n        behavior: 'smooth'\n      });\n    },\n    async confirmDelete(exercise) {\n      if (!confirm(`Удалить упражнение \"${exercise.exerciseTitle}\"?`)) return;\n      try {\n        await exerciseApi.delete(exercise.exerciseId);\n        await this.fetchExercises();\n        if (this.isEditing && this.formData.exerciseId === exercise.exerciseId) {\n          this.resetForm();\n        }\n      } catch (error) {\n        alert(error.displayMessage || 'Не удалось удалить упражнение');\n      }\n    },\n    resetForm() {\n      this.isEditing = false;\n      this.formData = {\n        exerciseId: null,\n        exerciseTitle: '',\n        active: true\n      };\n    }\n  }\n};","map":{"version":3,"names":["exerciseApi","name","data","exercises","loading","isEditing","formData","exerciseId","exerciseTitle","active","mounted","fetchExercises","methods","response","getAll","error","alert","displayMessage","saveExercise","trim","payload","update","create","resetForm","editExercise","exercise","document","querySelector","scrollIntoView","behavior","confirmDelete","confirm","delete"],"sources":["C:\\Users\\W\\Desktop\\практика\\training-app-client\\src\\components\\ExercisesList.vue"],"sourcesContent":["<template>\r\n  <div class=\"exercises-container\">\r\n    <h2 class=\"section-title\">📋 Упражнения</h2>\r\n    \r\n    <div class=\"exercise-form card\">\r\n      <h3>{{ isEditing ? 'Редактировать упражнение' : 'Добавить упражнение' }}</h3>\r\n      <form @submit.prevent=\"saveExercise\">\r\n        <div class=\"form-group\">\r\n          <label for=\"exerciseTitle\">Название упражнения *</label>\r\n          <input\r\n            id=\"exerciseTitle\"\r\n            v-model=\"formData.exerciseTitle\"\r\n            type=\"text\"\r\n            class=\"form-control\"\r\n            placeholder=\"Введите название упражнения\"\r\n            required\r\n            maxlength=\"100\"\r\n          />\r\n        </div>\r\n        \r\n        <div class=\"form-group\">\r\n          <label>\r\n            <input v-model=\"formData.active\" type=\"checkbox\" />\r\n            Активное\r\n          </label>\r\n          <small class=\"text-muted\">Неактивные упражнения не будут отображаться в списках</small>\r\n        </div>\r\n        \r\n        <div class=\"form-actions\">\r\n          <button type=\"submit\" class=\"btn btn-primary\">\r\n            {{ isEditing ? 'Обновить' : 'Создать' }}\r\n          </button>\r\n          <button v-if=\"isEditing\" type=\"button\" class=\"btn btn-secondary\" @click=\"resetForm\">\r\n            Отмена\r\n          </button>\r\n        </div>\r\n      </form>\r\n    </div>\r\n    \r\n    <!-- Список упражнений -->\r\n    <div class=\"exercises-list\">\r\n      <div class=\"list-header\">\r\n        <span>Название</span>\r\n        <span>Статус</span>\r\n        <span>Действия</span>\r\n      </div>\r\n      \r\n      <div v-if=\"loading\" class=\"loading-spinner\">Загрузка...</div>\r\n      <div v-else-if=\"exercises.length === 0\" class=\"empty-state\">\r\n        Упражнений пока нет. Создайте первое!\r\n      </div>\r\n      \r\n      <div\r\n        v-for=\"exercise in exercises\"\r\n        :key=\"exercise.exerciseId\"\r\n        class=\"exercise-item\"\r\n        :class=\"{ 'inactive': !exercise.active }\"\r\n      >\r\n        <span class=\"exercise-title\">{{ exercise.exerciseTitle }}</span>\r\n        \r\n        <span class=\"exercise-status\">\r\n          <span :class=\"['badge', exercise.active ? 'badge-success' : 'badge-secondary']\">\r\n            {{ exercise.active ? 'Активно' : 'Неактивно' }}\r\n          </span>\r\n        </span>\r\n        \r\n        <span class=\"exercise-actions\">\r\n          <button class=\"btn btn-sm btn-warning\" @click=\"editExercise(exercise)\">\r\n            ✏️\r\n          </button>\r\n          <button class=\"btn btn-sm btn-danger\" @click=\"confirmDelete(exercise)\">\r\n            🗑️\r\n          </button>\r\n        </span>\r\n      </div>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport { exerciseApi } from '../services/apiService';\r\n\r\nexport default {\r\n  name: 'ExercisesList',\r\n  data() {\r\n    return {\r\n      exercises: [],\r\n      loading: false,\r\n      isEditing: false,\r\n      formData: {\r\n        exerciseId: null,\r\n        exerciseTitle: '',\r\n        active: true\r\n      }\r\n    };\r\n  },\r\n  mounted() {\r\n    this.fetchExercises();\r\n  },\r\n  methods: {\r\n    async fetchExercises() {\r\n      this.loading = true;\r\n      try {\r\n        const response = await exerciseApi.getAll();\r\n        this.exercises = response.data;\r\n      } catch (error) {\r\n        alert(error.displayMessage || 'Не удалось загрузить упражнения');\r\n      } finally {\r\n        this.loading = false;\r\n      }\r\n    },\r\n    \r\n    async saveExercise() {\r\n      try {\r\n        if (!this.formData.exerciseTitle.trim()) {\r\n          alert('Название упражнения обязательно');\r\n          return;\r\n        }\r\n        \r\n        const payload = {\r\n          exerciseTitle: this.formData.exerciseTitle.trim(),\r\n          active: this.formData.active\r\n        };\r\n        \r\n        if (this.isEditing && this.formData.exerciseId) {\r\n          await exerciseApi.update(this.formData.exerciseId, payload);\r\n        } else {\r\n          await exerciseApi.create(payload);\r\n        }\r\n        \r\n        await this.fetchExercises();\r\n        this.resetForm();\r\n      } catch (error) {\r\n        alert(error.displayMessage || 'Ошибка при сохранении упражнения');\r\n      }\r\n    },\r\n    \r\n    editExercise(exercise) {\r\n      this.isEditing = true;\r\n      this.formData = {\r\n        exerciseId: exercise.exerciseId,\r\n        exerciseTitle: exercise.exerciseTitle,\r\n        active: exercise.active\r\n      };\r\n      // Прокрутка к форме\r\n      document.querySelector('.exercise-form').scrollIntoView({ behavior: 'smooth' });\r\n    },\r\n    \r\n    async confirmDelete(exercise) {\r\n      if (!confirm(`Удалить упражнение \"${exercise.exerciseTitle}\"?`)) return;\r\n      \r\n      try {\r\n        await exerciseApi.delete(exercise.exerciseId);\r\n        await this.fetchExercises();\r\n        if (this.isEditing && this.formData.exerciseId === exercise.exerciseId) {\r\n          this.resetForm();\r\n        }\r\n      } catch (error) {\r\n        alert(error.displayMessage || 'Не удалось удалить упражнение');\r\n      }\r\n    },\r\n    \r\n    resetForm() {\r\n      this.isEditing = false;\r\n      this.formData = {\r\n        exerciseId: null,\r\n        exerciseTitle: '',\r\n        active: true\r\n      };\r\n    }\r\n  }\r\n};\r\n</script>\r\n\r\n<style scoped>\r\n.exercises-container {\r\n  max-width: 800px;\r\n  margin: 0 auto;\r\n  padding: 20px;\r\n}\r\n\r\n.section-title {\r\n  margin-bottom: 24px;\r\n  color: #2c3e50;\r\n}\r\n\r\n.card {\r\n  background: white;\r\n  border-radius: 8px;\r\n  padding: 20px;\r\n  margin-bottom: 30px;\r\n  box-shadow: 0 2px 8px rgba(0,0,0,0.1);\r\n}\r\n\r\n.form-group {\r\n  margin-bottom: 16px;\r\n}\r\n\r\n.form-group label {\r\n  display: block;\r\n  margin-bottom: 4px;\r\n  font-weight: 500;\r\n}\r\n\r\n.form-control {\r\n  width: 100%;\r\n  padding: 8px 12px;\r\n  border: 1px solid #ddd;\r\n  border-radius: 4px;\r\n  font-size: 14px;\r\n}\r\n\r\n.form-control:focus {\r\n  border-color: #42b983;\r\n  outline: none;\r\n  box-shadow: 0 0 0 2px rgba(66, 185, 131, 0.2);\r\n}\r\n\r\n.form-actions {\r\n  display: flex;\r\n  gap: 8px;\r\n  margin-top: 12px;\r\n}\r\n\r\n.btn {\r\n  padding: 8px 20px;\r\n  border: none;\r\n  border-radius: 4px;\r\n  cursor: pointer;\r\n  font-size: 14px;\r\n  transition: background 0.2s;\r\n}\r\n\r\n.btn-primary {\r\n  background: #42b983;\r\n  color: white;\r\n}\r\n.btn-primary:hover {\r\n  background: #359268;\r\n}\r\n\r\n.btn-secondary {\r\n  background: #6c757d;\r\n  color: white;\r\n}\r\n.btn-secondary:hover {\r\n  background: #5a6268;\r\n}\r\n\r\n.btn-warning {\r\n  background: #ffc107;\r\n  color: #212529;\r\n}\r\n.btn-warning:hover {\r\n  background: #e0a800;\r\n}\r\n\r\n.btn-danger {\r\n  background: #dc3545;\r\n  color: white;\r\n}\r\n.btn-danger:hover {\r\n  background: #bd2130;\r\n}\r\n\r\n.btn-sm {\r\n  padding: 4px 8px;\r\n  font-size: 12px;\r\n}\r\n\r\n.list-header {\r\n  display: grid;\r\n  grid-template-columns: 2fr 1fr 1fr;\r\n  padding: 10px 12px;\r\n  font-weight: 600;\r\n  border-bottom: 2px solid #e9ecef;\r\n  background: #f8f9fa;\r\n  border-radius: 4px 4px 0 0;\r\n}\r\n\r\n.exercise-item {\r\n  display: grid;\r\n  grid-template-columns: 2fr 1fr 1fr;\r\n  align-items: center;\r\n  padding: 10px 12px;\r\n  border-bottom: 1px solid #e9ecef;\r\n  background: white;\r\n}\r\n\r\n.exercise-item:hover {\r\n  background: #f8f9fa;\r\n}\r\n\r\n.exercise-item.inactive {\r\n  opacity: 0.6;\r\n}\r\n\r\n.exercise-title {\r\n  font-weight: 500;\r\n  word-break: break-word;\r\n  padding-right: 12px;\r\n}\r\n\r\n.badge {\r\n  padding: 4px 12px;\r\n  border-radius: 20px;\r\n  font-size: 12px;\r\n  font-weight: 500;\r\n}\r\n\r\n.badge-success {\r\n  background: #d4edda;\r\n  color: #155724;\r\n}\r\n\r\n.badge-secondary {\r\n  background: #e9ecef;\r\n  color: #6c757d;\r\n}\r\n\r\n.exercise-actions {\r\n  display: flex;\r\n  gap: 6px;\r\n  justify-content: flex-end;\r\n}\r\n\r\n.loading-spinner {\r\n  padding: 40px;\r\n  text-align: center;\r\n  color: #6c757d;\r\n}\r\n\r\n.empty-state {\r\n  padding: 40px;\r\n  text-align: center;\r\n  color: #6c757d;\r\n  background: #f8f9fa;\r\n  border-radius: 4px;\r\n}\r\n\r\n.text-muted {\r\n  color: #6c757d;\r\n  font-size: 12px;\r\n  display: block;\r\n  margin-top: 4px;\r\n}\r\n</style>"],"mappings":"AAgFA,SAASA,WAAU,QAAS,wBAAwB;AAEpD,eAAe;EACbC,IAAI,EAAE,eAAe;EACrBC,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,SAAS,EAAE,EAAE;MACbC,OAAO,EAAE,KAAK;MACdC,SAAS,EAAE,KAAK;MAChBC,QAAQ,EAAE;QACRC,UAAU,EAAE,IAAI;QAChBC,aAAa,EAAE,EAAE;QACjBC,MAAM,EAAE;MACV;IACF,CAAC;EACH,CAAC;EACDC,OAAOA,CAAA,EAAG;IACR,IAAI,CAACC,cAAc,CAAC,CAAC;EACvB,CAAC;EACDC,OAAO,EAAE;IACP,MAAMD,cAAcA,CAAA,EAAG;MACrB,IAAI,CAACP,OAAM,GAAI,IAAI;MACnB,IAAI;QACF,MAAMS,QAAO,GAAI,MAAMb,WAAW,CAACc,MAAM,CAAC,CAAC;QAC3C,IAAI,CAACX,SAAQ,GAAIU,QAAQ,CAACX,IAAI;MAChC,EA