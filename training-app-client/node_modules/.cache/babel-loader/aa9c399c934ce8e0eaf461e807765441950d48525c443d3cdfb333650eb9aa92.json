{"ast":null,"code":"import \"core-js/modules/es.iterator.constructor.js\";\nimport \"core-js/modules/es.iterator.filter.js\";\nimport { activityApi, exerciseApi } from '../services/apiService';\nexport default {\n  name: 'ActivitiesList',\n  data() {\n    return {\n      activities: [],\n      availableExercises: [],\n      loading: false,\n      isEditing: false,\n      formData: {\n        activityId: null,\n        exerciseId: '',\n        dateActivity: this.getToday(),\n        duration: null,\n        note: ''\n      }\n    };\n  },\n  mounted() {\n    this.fetchActivities();\n    this.fetchAvailableExercises();\n  },\n  methods: {\n    getToday() {\n      const today = new Date();\n      return today.toISOString().split('T')[0];\n    },\n    formatDate(dateStr) {\n      if (!dateStr) return '—';\n      const date = new Date(dateStr);\n      return date.toLocaleDateString('ru-RU', {\n        day: '2-digit',\n        month: '2-digit',\n        year: 'numeric'\n      });\n    },\n    async fetchActivities() {\n      this.loading = true;\n      try {\n        const response = await activityApi.getAllWithDetails();\n        this.activities = response.data;\n      } catch (error) {\n        alert(error.displayMessage || 'Не удалось загрузить активности');\n      } finally {\n        this.loading = false;\n      }\n    },\n    async fetchAvailableExercises() {\n      try {\n        const response = await exerciseApi.getActive();\n        this.availableExercises = response.data;\n      } catch (error) {\n        // Если нет эндпоинта /exercises/active, используем обычный getAll\n        try {\n          const response = await exerciseApi.getAll();\n          this.availableExercises = response.data.filter(ex => ex.active);\n        } catch (err) {\n          console.error('Не удалось загрузить упражнения:', err);\n        }\n      }\n    },\n    async saveActivity() {\n      try {\n        if (!this.formData.exerciseId) {\n          alert('Выберите упражнение');\n          return;\n        }\n        const payload = {\n          exerciseId: this.formData.exerciseId,\n          dateActivity: this.formData.dateActivity,\n          duration: this.formData.duration || null,\n          note: this.formData.note?.trim() || null\n        };\n        if (this.isEditing && this.formData.activityId) {\n          await activityApi.update(this.formData.activityId, payload);\n        } else {\n          await activityApi.create(payload);\n        }\n        await this.fetchActivities();\n        this.resetForm();\n      } catch (error) {\n        alert(error.displayMessage || 'Ошибка при сохранении активности');\n      }\n    },\n    editActivity(activity) {\n      this.isEditing = true;\n      this.formData = {\n        activityId: activity.activityId,\n        exerciseId: activity.exerciseId || '',\n        dateActivity: activity.dateActivity || this.getToday(),\n        duration: activity.duration || null,\n        note: activity.note || ''\n      };\n      document.querySelector('.activity-form').scrollIntoView({\n        behavior: 'smooth'\n      });\n    },\n    async confirmDelete(activity) {\n      if (!confirm(`Удалить активность \"${activity.exerciseTitle}\" от ${this.formatDate(activity.dateActivity)}?`)) return;\n      try {\n        await activityApi.delete(activity.activityId);\n        await this.fetchActivities();\n        if (this.isEditing && this.formData.activityId === activity.activityId) {\n          this.resetForm();\n        }\n      } catch (error) {\n        alert(error.displayMessage || 'Не удалось удалить активность');\n      }\n    },\n    resetForm() {\n      this.isEditing = false;\n      this.formData = {\n        activityId: null,\n        exerciseId: '',\n        dateActivity: this.getToday(),\n        duration: null,\n        note: ''\n      };\n    }\n  }\n};","map":{"version":3,"names":["activityApi","exerciseApi","name","data","activities","availableExercises","loading","isEditing","formData","activityId","exerciseId","dateActivity","getToday","duration","note","mounted","fetchActivities","fetchAvailableExercises","methods","today","Date","toISOString","split","formatDate","dateStr","date","toLocaleDateString","day","month","year","response","getAllWithDetails","error","alert","displayMessage","getActive","getAll","filter","ex","active","err","console","saveActivity","payload","trim","update","create","resetForm","editActivity","activity","document","querySelector","scrollIntoView","behavior","confirmDelete","confirm","exerciseTitle","delete"],"sources":["C:\\Users\\W\\Desktop\\практика\\training-app-client\\src\\components\\ActivitiesList.vue"],"sourcesContent":["<template>\r\n  <div class=\"activities-container\">\r\n    <h2 class=\"section-title\">🏋️ Активности</h2>\r\n    \r\n    <div class=\"activity-form card\">\r\n      <h3>{{ isEditing ? 'Редактировать активность' : 'Добавить активность' }}</h3>\r\n      <form @submit.prevent=\"saveActivity\">\r\n        <div class=\"form-group\">\r\n          <label for=\"exerciseId\">Упражнение *</label>\r\n          <select\r\n            id=\"exerciseId\"\r\n            v-model=\"formData.exerciseId\"\r\n            class=\"form-control\"\r\n            required\r\n          >\r\n            <option value=\"\">Выберите упражнение</option>\r\n            <option\r\n              v-for=\"exercise in availableExercises\"\r\n              :key=\"exercise.exerciseId\"\r\n              :value=\"exercise.exerciseId\"\r\n            >\r\n              {{ exercise.exerciseTitle }}\r\n            </option>\r\n          </select>\r\n        </div>\r\n        \r\n        <div class=\"form-row\">\r\n          <div class=\"form-group\">\r\n            <label for=\"dateActivity\">Дата *</label>\r\n            <input\r\n              id=\"dateActivity\"\r\n              v-model=\"formData.dateActivity\"\r\n              type=\"date\"\r\n              class=\"form-control\"\r\n              required\r\n            />\r\n          </div>\r\n          \r\n          <div class=\"form-group\">\r\n            <label for=\"duration\">Длительность (мин)</label>\r\n            <input\r\n              id=\"duration\"\r\n              v-model.number=\"formData.duration\"\r\n              type=\"number\"\r\n              class=\"form-control\"\r\n              min=\"1\"\r\n              placeholder=\"Например: 30\"\r\n            />\r\n          </div>\r\n        </div>\r\n        \r\n        <div class=\"form-group\">\r\n          <label for=\"note\">Заметка</label>\r\n          <textarea\r\n            id=\"note\"\r\n            v-model=\"formData.note\"\r\n            class=\"form-control\"\r\n            rows=\"3\"\r\n            maxlength=\"300\"\r\n            placeholder=\"Дополнительные заметки...\"\r\n          ></textarea>\r\n          <small class=\"text-muted\">{{ formData.note?.length || 0 }}/300</small>\r\n        </div>\r\n        \r\n        <div class=\"form-actions\">\r\n          <button type=\"submit\" class=\"btn btn-primary\">\r\n            {{ isEditing ? 'Обновить' : 'Создать' }}\r\n          </button>\r\n          <button v-if=\"isEditing\" type=\"button\" class=\"btn btn-secondary\" @click=\"resetForm\">\r\n            Отмена\r\n          </button>\r\n        </div>\r\n      </form>\r\n    </div>\r\n    \r\n    <!-- Список активностей -->\r\n    <div class=\"activities-list\">\r\n      <div class=\"list-header\">\r\n        <span>Упражнение</span>\r\n        <span>Дата</span>\r\n        <span>Длительность</span>\r\n        <span>Статус</span>\r\n        <span>Действия</span>\r\n      </div>\r\n      \r\n      <div v-if=\"loading\" class=\"loading-spinner\">Загрузка...</div>\r\n      <div v-else-if=\"activities.length === 0\" class=\"empty-state\">\r\n        Активностей пока нет. Начните тренироваться!\r\n      </div>\r\n      \r\n      <div\r\n        v-for=\"activity in activities\"\r\n        :key=\"activity.activityId\"\r\n        class=\"activity-item\"\r\n        :class=\"{ 'locked': activity.exerciseLocked }\"\r\n      >\r\n        <span class=\"activity-exercise\">{{ activity.exerciseTitle }}</span>\r\n        \r\n        <span class=\"activity-date\">{{ formatDate(activity.dateActivity) }}</span>\r\n        \r\n        <span class=\"activity-duration\">\r\n          {{ activity.duration ? activity.duration + ' мин' : '—' }}\r\n        </span>\r\n        \r\n        <span class=\"activity-locked\">\r\n          <span :class=\"['badge', activity.exerciseLocked ? 'badge-danger' : 'badge-success']\">\r\n            {{ activity.exerciseLocked ? '🔒 Заблокировано' : '✅ Доступно' }}\r\n          </span>\r\n        </span>\r\n        \r\n        <span class=\"activity-actions\">\r\n          <button class=\"btn btn-sm btn-warning\" @click=\"editActivity(activity)\">\r\n            ✏️\r\n          </button>\r\n          <button class=\"btn btn-sm btn-danger\" @click=\"confirmDelete(activity)\">\r\n            🗑️\r\n          </button>\r\n        </span>\r\n      </div>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport { activityApi, exerciseApi } from '../services/apiService';\r\n\r\nexport default {\r\n  name: 'ActivitiesList',\r\n  data() {\r\n    return {\r\n      activities: [],\r\n      availableExercises: [],\r\n      loading: false,\r\n      isEditing: false,\r\n      formData: {\r\n        activityId: null,\r\n        exerciseId: '',\r\n        dateActivity: this.getToday(),\r\n        duration: null,\r\n        note: ''\r\n      }\r\n    };\r\n  },\r\n  mounted() {\r\n    this.fetchActivities();\r\n    this.fetchAvailableExercises();\r\n  },\r\n  methods: {\r\n    getToday() {\r\n      const today = new Date();\r\n      return today.toISOString().split('T')[0];\r\n    },\r\n    \r\n    formatDate(dateStr) {\r\n      if (!dateStr) return '—';\r\n      const date = new Date(dateStr);\r\n      return date.toLocaleDateString('ru-RU', {\r\n        day: '2-digit',\r\n        month: '2-digit',\r\n        year: 'numeric'\r\n      });\r\n    },\r\n    \r\n    async fetchActivities() {\r\n      this.loading = true;\r\n      try {\r\n        const response = await activityApi.getAllWithDetails();\r\n        this.activities = response.data;\r\n      } catch (error) {\r\n        alert(error.displayMessage || 'Не удалось загрузить активности');\r\n      } finally {\r\n        this.loading = false;\r\n      }\r\n    },\r\n    \r\n    async fetchAvailableExercises() {\r\n      try {\r\n        const response = await exerciseApi.getActive();\r\n        this.availableExercises = response.data;\r\n      } catch (error) {\r\n        // Если нет эндпоинта /exercises/active, используем обычный getAll\r\n        try {\r\n          const response = await exerciseApi.getAll();\r\n          this.availableExercises = response.data.filter(ex => ex.active);\r\n        } catch (err) {\r\n          console.error('Не удалось загрузить упражнения:', err);\r\n        }\r\n      }\r\n    },\r\n    \r\n    async saveActivity() {\r\n      try {\r\n        if (!this.formData.exerciseId) {\r\n          alert('Выберите упражнение');\r\n          return;\r\n        }\r\n        \r\n        const payload = {\r\n          exerciseId: this.formData.exerciseId,\r\n          dateActivity: this.formData.dateActivity,\r\n          duration: this.formData.duration || null,\r\n          note: this.formData.note?.trim() || null\r\n        };\r\n        \r\n        if (this.isEditing && this.formData.activityId) {\r\n          await activityApi.update(this.formData.activityId, payload);\r\n        } else {\r\n          await activityApi.create(payload);\r\n        }\r\n        \r\n        await this.fetchActivities();\r\n        this.resetForm();\r\n      } catch (error) {\r\n        alert(error.displayMessage || 'Ошибка при сохранении активности');\r\n      }\r\n    },\r\n    \r\n    editActivity(activity) {\r\n      this.isEditing = true;\r\n      this.formData = {\r\n        activityId: activity.activityId,\r\n        exerciseId: activity.exerciseId || '',\r\n        dateActivity: activity.dateActivity || this.getToday(),\r\n        duration: activity.duration || null,\r\n        note: activity.note || ''\r\n      };\r\n      document.querySelector('.activity-form').scrollIntoView({ behavior: 'smooth' });\r\n    },\r\n    \r\n    async confirmDelete(activity) {\r\n      if (!confirm(`Удалить активность \"${activity.exerciseTitle}\" от ${this.formatDate(activity.dateActivity)}?`)) return;\r\n      \r\n      try {\r\n        await activityApi.delete(activity.activityId);\r\n        await this.fetchActivities();\r\n        if (this.isEditing && this.formData.activityId === activity.activityId) {\r\n          this.resetForm();\r\n        }\r\n      } catch (error) {\r\n        alert(error.displayMessage || 'Не удалось удалить активность');\r\n      }\r\n    },\r\n    \r\n    resetForm() {\r\n      this.isEditing = false;\r\n      this.formData = {\r\n        activityId: null,\r\n        exerciseId: '',\r\n        dateActivity: this.getToday(),\r\n        duration: null,\r\n        note: ''\r\n      };\r\n    }\r\n  }\r\n};\r\n</script>\r\n\r\n<style scoped>\r\n/* Стили аналогичны ExercisesList, добавляем специфичные */\r\n.activities-container {\r\n  max-width: 900px;\r\n  margin: 0 auto;\r\n  padding: 20px;\r\n}\r\n\r\n.card {\r\n  background: white;\r\n  border-radius: 8px;\r\n  padding: 20px;\r\n  margin-bottom: 30px;\r\n  box-shadow: 0 2px 8px rgba(0,0,0,0.1);\r\n}\r\n\r\n.form-row {\r\n  display: grid;\r\n  grid-template-columns: 1fr 1fr;\r\n  gap: 16px;\r\n}\r\n\r\n.list-header {\r\n  display: grid;\r\n  grid-template-columns: 2fr 1.5fr 1fr 1.5fr 1fr;\r\n  padding: 10px 12px;\r\n  font-weight: 600;\r\n  border-bottom: 2px solid #e9ecef;\r\n  background: #f8f9fa;\r\n  border-radius: 4px 4px 0 0;\r\n}\r\n\r\n.activity-item {\r\n  display: grid;\r\n  grid-template-columns: 2fr 1.5fr 1fr 1.5fr 1fr;\r\n  align-items: center;\r\n  padding: 10px 12px;\r\n  border-bottom: 1px solid #e9ecef;\r\n  background: white;\r\n}\r\n\r\n.activity-item:hover {\r\n  background: #f8f9fa;\r\n}\r\n\r\n.activity-item.locked {\r\n  background: #fff5f5;\r\n}\r\n.activity-item.locked:hover {\r\n  background: #ffebeb;\r\n}\r\n\r\n.activity-exercise {\r\n  font-weight: 500;\r\n  word-break: break-word;\r\n  padding-right: 12px;\r\n}\r\n\r\n.activity-date {\r\n  color: #495057;\r\n}\r\n\r\n.activity-duration {\r\n  text-align: center;\r\n}\r\n\r\n.badge-danger {\r\n  background: #f8d7da;\r\n  color: #721c24;\r\n}\r\n\r\ntextarea.form-control {\r\n  resize: vertical;\r\n  font-family: inherit;\r\n}\r\n\r\n@media (max-width: 768px) {\r\n  .form-row {\r\n    grid-template-columns: 1fr;\r\n  }\r\n  \r\n  .list-header, .activity-item {\r\n    grid-template-columns: 1fr;\r\n    gap: 6px;\r\n    text-align: left;\r\n  }\r\n  \r\n  .list-header {\r\n    display: none;\r\n  }\r\n  \r\n  .activity-item {\r\n    border: 1px solid #e9ecef;\r\n    border-radius: 4px;\r\n    margin-bottom: 8px;\r\n    padding: 12px;\r\n  }\r\n  \r\n  .activity-actions {\r\n    justify-content: flex-start;\r\n    margin-top: 4px;\r\n  }\r\n}\r\n</style>"],"mappings":";;AA4HA,SAASA,WAAW,EAAEC,WAAU,QAAS,wBAAwB;AAEjE,eAAe;EACbC,IAAI,EAAE,gBAAgB;EACtBC,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,UAAU,EAAE,EAAE;MACdC,kBAAkB,EAAE,EAAE;MACtBC,OAAO,EAAE,KAAK;MACdC,SAAS,EAAE,KAAK;MAChBC,QAAQ,EAAE;QACRC,UAAU,EAAE,IAAI;QAChBC,UAAU,EAAE,EAAE;QACdC,YAAY,EAAE,IAAI,CAACC,QAAQ,CAAC,CAAC;QAC7BC,QAAQ,EAAE,IAAI;QACdC,IAAI,EAAE;MACR;IACF,CAAC;EACH,CAAC;EACDC,OAAOA,CAAA,EAAG;IACR,IAAI,CAACC,eAAe,CAAC,CAAC;IACtB,IAAI,CAACC,uBAAuB,CAAC,CAAC;EAChC,CAAC;EACDC,OAAO,EAAE;IACPN,QAAQA,CAAA,EAAG;MACT,MAAMO,KAAI,GAAI,IAAIC,IAAI,CAAC,CAAC;MACxB,OAAOD,KAAK,CAACE,WAAW,CAAC,CAAC,CAACC,KAAK,CAAC,GAAG,CAAC,CAAC,CAAC,CAAC;IAC1C,CAAC;IAEDC,UAAUA,CAACC,OAAO,EAAE;MAClB,IAAI,CAACA,OAAO,EAAE,OAAO,GAAG;MACxB,MAAMC,IAAG,GAAI,IAAIL,IAAI,CAACI,OAAO,CAAC;MAC9B,OAAOC,IAAI,CAACC,kBAAkB,CAAC,OAAO,EAAE;QACtCC,GAAG,EAAE,SAAS;QACdC,KAAK,EAAE,SAAS;QAChBC,IAAI,EAAE;MACR,CAAC,CA